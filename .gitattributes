# Fins de ligne : LF partout dans le dépôt et dans la copie de travail,
# quel que soit le réglage core.autocrlf du poste.
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires : jamais de conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.glb binary
*.gltf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.zip binary
